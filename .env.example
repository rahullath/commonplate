# Copy to .env and fill in. NEVER commit .env.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ADMIN_TOKEN=

# Shiprocket Quick (hyperlocal delivery)
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_CHANNEL_ID=

# Petpooja POS integration (India). Optional; leave blank to run without a POS.
# Setting these four is what turns the integration on (see app/petpooja/).
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_REST_ID=
# Random string we generate ourselves — bake it into the webhook URLs we
# hand Petpooja (?t=...) since their docs don't specify request signing.
PETPOOJA_WEBHOOK_TOKEN=
# Static-IP HTTP proxy for all outbound Petpooja calls (live integration
# needs a fixed source IP — §3.7). Blank = direct (fine for sandbox).
PETPOOJA_PROXY_URL=
# Production endpoints (defaults in config.py are the staging API Gateway —
# prod lives on pponlineordercb.petpooja.com, no /V1/ prefix). Set ALL THREE
# on Railway for production; leave unset for sandbox work.
# PETPOOJA_SAVE_ORDER_URL=https://pponlineordercb.petpooja.com/save_order
# PETPOOJA_UPDATE_ORDER_STATUS_URL=https://pponlineordercb.petpooja.com/update_order_status
# PETPOOJA_RIDER_STATUS_URL=https://pponlineordercb.petpooja.com/rider_status_update

# SEO (all optional). BIZ_SITE_URL must be your real https origin: it drives
# canonicals, the sitemap and structured data.
# BIZ_GOOGLE_SITE_VERIFICATION=
# BIZ_BING_SITE_VERIFICATION=
# BIZ_FACEBOOK_DOMAIN_VERIFICATION=
# BIZ_GA_MEASUREMENT_ID=
# GOOGLE_REVIEW_LINK=
